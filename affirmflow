function deleteJournalEntry(index) {
  const history = getJournalData();
  if (index < 0 || index >= history.length) return;
  const entry = history[index];
  history.splice(index, 1);
  setJournalData(history, entry?.id);

  if (currentJournalIndex === index) {
    currentJournalIndex = history.length ? Math.min(index, history.length - 1) : null;
  } else if (currentJournalIndex > index) {
    currentJournalIndex -= 1;
  }
  if (history.length === 0) {
    editingExistingEntry = false;
  }

  loadJournalHistory();
  if (history.length && currentJournalIndex !== null) {
    loadJournalEntryByIndex(currentJournalIndex);
  } else {
    const out = document.getElementById("journalOutput");
    if (out) {
      out.innerHTML =
        "<p>Your transformed reflections will appear here. Tap to type your own words or edit.</p>";
    }
  }
}

