function appendWinsToJournal(items) {
  if (!items || !items.length) return;
  const { history, index: idx, todayStr } = ensureActiveJournalEntry();
  const entry = history[idx] || {};
  const header = "Things I did well today:";
  const bullets = items.map((i) => `- ${i}`).join("\n");
  const merged = mergeSection(entry, header, bullets);

  history[idx] = {
    ...entry,
    title: entry.title || journalTitle || "Things I did well today",
    raw: merged.raw,
    ai: merged.ai,
    date: entry.date || new Date().toLocaleString(),
    entryDate: entry.entryDate || todayStr,
    mood: journalMood,
    focus: journalFocus,
  };
  currentJournalIndex = idx;
  editingExistingEntry = true;

  setJournalData(history);
  loadJournalHistory();

  const out = document.getElementById("journalOutput");
  if (out) {
    out.innerHTML = formatMultiline(history[currentJournalIndex].ai || "");
  }
}

function ensureActiveJournalEntry() {
  const history = getJournalData();
  const todayStr = new Date().toISOString().slice(0, 10);

  // If editing an existing entry, keep using it.
  if (
    editingExistingEntry &&
    currentJournalIndex !== null &&
    history[currentJournalIndex]
  ) {
    return { history, index: currentJournalIndex, todayStr };
  }

  // Otherwise, create a fresh entry (allows multiple entries per day).
  const newEntry = {
    id: crypto.randomUUID ? crypto.randomUUID() : Date.now(),
    title: journalTitle || "Daily Entry",
    raw: "",
    ai: "",
    date: new Date().toLocaleString(),
    entryDate: todayStr,
    mood: journalMood,
    focus: journalFocus,
  };
  history.push(newEntry);
  currentJournalIndex = history.length - 1;
  editingExistingEntry = true;
  return { history, index: currentJournalIndex, todayStr };
}

function mergeSection(entry, header, content) {
  const boldHeader = `<strong>${header}</strong>`;
  const stripSection = (text) => {
    if (!text || (!text.includes(header) && !text.includes(boldHeader)))
      return text || "";
    const lines = text.split("\n");
    const kept = [];
    let skipping = false;
    const isHeaderLine = (line) =>
      line.startsWith(header) ||
      line.startsWith(boldHeader) ||
      line.includes(`>${header}</strong>`);

    lines.forEach((line) => {
      if (!skipping && isHeaderLine(line)) {
        skipping = true;
        return;
      }
      if (skipping) {
        const nextHeader =
          /^[A-Za-z].*:/.test(line) ||
          line.startsWith("Affirmation of the Day") ||
          line.startsWith("<strong>Affirmation of the Day");
        const nextWinHeader =
          header === "Things I did well today:" &&
          !line.startsWith("- ") &&
          line.trim() !== "";
        if (nextHeader || nextWinHeader || isHeaderLine(line)) {
          skipping = false;
          kept.push(line);
        }
      } else {
        kept.push(line);
      }
    });
    return kept.join("\n").trim();
  };

  const cleanedRaw = stripSection(entry.raw || "");
  const cleanedAi = stripSection(entry.ai || "");
  const section = `${boldHeader}\n${content}`;
  const newRaw = cleanedRaw ? `${cleanedRaw}\n${section}` : section;
  const newAi = cleanedAi ? `${cleanedAi}\n${section}` : section;

  return { raw: newRaw, ai: newAi };
}

