      </div>
      <div class="pill">v0.1 • MVP</div>
    </header>

    <main>
      <!-- === HOME SCREEN === -->
      <!-- CHANGE NOTE: Labeled home screen entry so navigation + feature tweaks are easy to locate. -->
      <!-- HOME -->
      <section id="screen-home">
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">✨</span>
              Quick Access
            </div>
          </div>
          <div class="chips">
            <button class="btn btn-ghost" onclick="showScreen('affirm')">
              ✨ Affirmations
            </button>
            <button class="btn btn-ghost" onclick="showScreen('journal')">
              📓 Journal
            </button>
            <button class="btn btn-ghost" onclick="showScreen('habit')">
              🔁 Habit
            </button>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">🔮</span>
              Today’s Energy
            </div>
          </div>
          <div class="card-main-text" id="quoteText"></div>
          <div class="card-subtext" id="quoteCategory"></div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">🔥</span>
              Glow-Up Streak
            </div>
          </div>
          <div class="home-streak-row">
            <div>
              <div class="streak-count" id="streakCount">0</div>
              <div class="streak-label" id="habitNameLabel">
                No habit set yet
              </div>
            </div>
            <button class="btn btn-primary" onclick="showScreen('habit')">
              Manage Habits
            </button>
          </div>
        </div>
      </section>

      <!-- === AFFIRMATION STUDIO SCREEN === -->
      <!-- CHANGE NOTE: Added screen label to quickly find affirmation UI when wiring real AI later. -->
      <!-- AFFIRM -->
      <section id="screen-affirm" class="hidden">
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">✨</span>
              Affirmation Studio
            </div>
          </div>

          <label for="moodSelect">Mood</label>
          <select id="moodSelect" onchange="handleMoodChange()">
            <option>Anxious</option>
            <option>Tired</option>
            <option>Hopeful</option>
            <option>Confident</option>
            <option>Stuck</option>
            <option value="custom">Custom…</option>
          </select>
          <input
            type="text"
            id="customMoodInput"
            class="hidden"
            placeholder="Type your mood"
            oninput="handleAffirmMoodInput()"
          />

          <label for="focusSelect">Focus Area</label>
          <select id="focusSelect" onchange="handleFocusChange()">
            <option>Money</option>
            <option>Healing</option>
            <option>Love</option>
            <option>Glow-Up</option>
            <option>Purpose</option>
            <option value="custom">Custom…</option>
          </select>
          <input
            type="text"
            id="customFocusInput"
            class="hidden"
            placeholder="Type your focus"
            oninput="handleAffirmFocusInput()"
          />

          <button class="btn btn-primary" onclick="generateAffirmationsAI()">
            Generate Affirmations
          </button>
          <div class="card-subtext">
            Uses AI when API key is set in Settings; falls back to mock otherwise.
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">📡</span>
              My Affirmations
            </div>
          </div>
          <div class="affirmations-list" id="affirmationsList">
            <p>Tap “Generate Affirmations” to receive 3 uplifting lines.</p>
          </div>
          <button class="btn btn-primary" onclick="saveAffirmationsToJournal()">
            Save to Journal
          </button>
          <div class="card-subtext">
            Sends your current affirmations into the Journal history.
          </div>
        </div>
      </section>

      <!-- === JOURNAL SCREEN === -->
      <!-- CHANGE NOTE: Marked journal section for fast access when integrating AI reflections. -->
      <!-- JOURNAL -->
      <section id="screen-journal" class="hidden">
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">📓</span>
              Journal Reflections
            </div>
          </div>

          <label for="journalTitleInput">Entry title</label>
          <input
            type="text"
            id="journalTitleInput"
            placeholder="Optional title for this entry"
            oninput="handleJournalTitleInput()"
          />

          <div class="prompt-row">
            <label id="journalPromptLabel" for="journalInput">
              One honest sentence
            </label>
            <button class="btn btn-ghost" type="button" onclick="nextJournalPrompt()">
              Next prompt
            </button>
          </div>
          <textarea
            id="journalInput"
            placeholder="Type your answer…"
          ></textarea>

          <label for="journalMoodSelect">Mood</label>
          <select id="journalMoodSelect" onchange="handleJournalMoodChange()">
            <option>Calm</option>
            <option>Anxious</option>
            <option>Hopeful</option>
            <option>Confident</option>
            <option>Reflective</option>
            <option value="custom">Custom…</option>
          </select>
          <input
            type="text"
            id="journalCustomMood"
            class="hidden"
            placeholder="Type your mood"
            oninput="handleJournalMoodInput()"
          />

          <label for="journalFocusSelect">Focus</label>
          <select id="journalFocusSelect" onchange="handleJournalFocusChange()">
            <option>Healing</option>
            <option>Rest</option>
            <option>Self-worth</option>
            <option>Productivity</option>
            <option>Relationships</option>
            <option value="custom">Custom…</option>
          </select>
          <input
            type="text"
            id="journalCustomFocus"
            class="hidden"
            placeholder="Type your focus"
            oninput="handleJournalFocusInput()"
          />

          <button class="btn btn-primary" onclick="transformJournalAI()">
            Transform into Reflection
          </button>
          <button class="btn btn-ghost" onclick="saveJournalRaw()">
            Save to Journal
          </button>

          <div class="card-subtext">
            One box, three prompts. Use “Next prompt” to cycle through them; mood & focus are saved too.
            We’ll swap this mock with real AI-powered reflections later.
          </div>
          <button class="btn btn-ghost" type="button" onclick="openJournalHistoryOverlay()">
            View All Entries
          </button>
          <button class="btn btn-ghost" type="button" onclick="startNewJournalEntry()">
            New Entry
          </button>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">💫</span>
              My Reflections
            </div>
          </div>
          <div
            class="journal-output"
            id="journalOutput"
            contenteditable="true"
            aria-label="Edit your reflection text"
          >
            <p>Your transformed reflections will appear here. Tap to type your own words or edit.</p>
          </div>
          <button class="btn btn-primary" onclick="saveEditedReflection()">
            Save to Journal
          </button>
          <div class="card-subtext">
            Edits above will update the current journal entry (tap a history row to load it).
          </div>
          <div class="journal-history" id="journalHistory"></div>
        </div>
      </section>

      <!-- === HABIT TRACKER SCREEN === -->
      <!-- CHANGE NOTE: Labeled habit tracker for quick streak logic UI edits. -->
      <!-- HABIT -->
      <section id="screen-habit" class="hidden">
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">🔁</span>
              Glow-Up Habit
            </div>
          </div>

          <label for="habitNameInput">Habit name</label>
          <input
            type="text"
            id="habitNameInput"
            placeholder="e.g. Night journaling, 10-min walk…"
          />

          <button class="btn btn-primary" onclick="addHabit()">
            Add Habit (max 10)
          </button>

          <div class="card-subtext">
            Track up to 10 habits. Each habit has 3 “freeze” tokens to protect
            your streak when you miss a day.
          </div>
        </div>

          <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">🔥</span>
              Glow-Up Streaks
            </div>
          </div>

          <div id="habitList" class="habit-list">
            <p class="streak-label">No habits yet. Add one above.</p>
          </div>

          <div class="card-subtext">
            Tap “Mark today” on each habit. Missing a day spends a freeze (3
            total) to keep your streak; after freezes are gone, streak resets.
          </div>
          <button class="btn btn-primary" onclick="saveTodayHabitsToJournal()">
            Save to Journal
          </button>
          <button class="btn btn-ghost" type="button" onclick="openHabitManager()">
            Manage Streaks
          </button>
        </div>
      </section>

      <!-- SETTINGS -->
      <section id="screen-settings" class="hidden">
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">⚙️</span>
              Settings
            </div>
          </div>
          <p class="card-main-text">
            Theme, journal, and habit controls live here. More coming soon.
          </p>
          <button class="btn btn-ghost" onclick="toggleTheme()">
            Toggle Theme
          </button>
          <button class="btn btn-ghost" onclick="startNewJournalEntry()">
            New Journal Entry
          </button>
          <label for="settingsApiKey">OpenAI API Key</label>
          <input
            id="settingsApiKey"
            type="password"
            placeholder="sk-..."
            autocomplete="off"
          />
          <button class="btn btn-primary" onclick="saveApiKey()">
            Save API Key
          </button>
          <div class="card-subtext">
            Key is stored locally in your browser. Required for AI affirmations
            and journal reflections.
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <span class="icon">🔐</span>
              Access Protection
            </div>
          </div>
          <label for="settingsUsername">Username</label>
          <input id="settingsUsername" type="text" placeholder="Set a username" />
          <label for="settingsPassword">Password</label>
          <input
            id="settingsPassword"
            type="password"
            placeholder="Set a password"
          />
          <button class="btn btn-primary" onclick="saveCredentials()">
            Save Credentials
          </button>
          <button class="btn btn-ghost" onclick="logoutUser()">
            Logout
          </button>
          <div class="card-subtext">
            Credentials are stored locally in your browser. Keep them simple,
            this is not a secure vault.
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Fullscreen reflection overlay -->
  <div id="reflectionOverlay" class="reflection-overlay hidden">
    <div class="reflection-overlay-inner">
      <div class="overlay-header">
        <div class="overlay-title">Reflection (fullscreen)</div>
        <button class="btn btn-ghost" type="button" onclick="closeReflectionOverlay()">
          Close
        </button>
      </div>
      <div
        id="reflectionOverlayContent"
        class="reflection-overlay-body"
        contenteditable="true"
        aria-label="Edit your reflection in fullscreen"
      ></div>
      <div class="overlay-footer">
        <button class="btn btn-primary" type="button" onclick="closeReflectionOverlay()">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- Fullscreen history overlay -->
  <div id="historyOverlay" class="history-overlay hidden">
    <div class="history-overlay-inner">
      <div class="overlay-header">
        <div class="overlay-title">Journal entries</div>
        <button class="btn btn-ghost" type="button" onclick="closeJournalHistoryOverlay()">
          Close
        </button>
      </div>
      <div id="historyOverlayList" class="history-overlay-body"></div>
    </div>
  </div>

  <!-- Fullscreen habit manager overlay -->
  <div id="habitOverlay" class="history-overlay hidden">
    <div class="history-overlay-inner">
      <div class="overlay-header">
        <div class="overlay-title">Manage Glow-Up Streaks</div>
        <button class="btn btn-ghost" type="button" onclick="closeHabitManager()">
          Close
        </button>
      </div>
      <div id="habitOverlayList" class="history-overlay-body"></div>
    </div>
  </div>

  <!-- Auth overlay -->
  <div id="authOverlay" class="history-overlay hidden">
    <div class="history-overlay-inner">
      <div class="overlay-header">
        <div class="overlay-title">Enter to Continue</div>
        <button class="btn btn-ghost" type="button" onclick="closeAuthOverlay()">
          Close
        </button>
      </div>
      <div class="history-item">
        <label for="authUsername">Username</label>
        <input id="authUsername" type="text" placeholder="Your username" />
        <label for="authPassword">Password</label>
        <input id="authPassword" type="password" placeholder="Your password" />
        <button class="btn btn-primary" onclick="loginUser()">
          Unlock
        </button>
        <button class="btn btn-ghost" type="button" onclick="signUpUser()">
          Create account
        </button>
        <div class="card-subtext">
          Uses Supabase email/password. Set credentials in Settings and log in here.
        </div>
      </div>
    </div>
  </div>

  <!-- === BOTTOM NAVIGATION === -->
  <!-- CHANGE NOTE: Tagging nav for easier styling/animation tweaks. -->
  <nav>
    <div class="nav-inner">
      <button
        class="nav-btn active"
        data-screen="home"
        onclick="showScreen('home')"
      >
        <span class="nav-btn-icon">🏠</span>
        <span>Home</span>
      </button>
      <button
        class="nav-btn"
        data-screen="affirm"
        onclick="showScreen('affirm')"
      >
        <span class="nav-btn-icon">✨</span>
        <span>Affirm</span>
      </button>
      <button
        class="nav-btn"
        data-screen="journal"
        onclick="showScreen('journal')"
      >
        <span class="nav-btn-icon">📓</span>
        <span>Journal</span>
      </button>
      <button
        class="nav-btn"
        data-screen="habit"
        onclick="showScreen('habit')"
      >
        <span class="nav-btn-icon">🔁</span>
        <span>Habit</span>
      </button>
      <button
        class="nav-btn"
        data-screen="settings"
        onclick="showScreen('settings')"
      >
        <span class="nav-btn-icon">⚙️</span>
        <span>Settings</span>
      </button>
    </div>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="app.js"></script>
</body>
</html>

:root {
  --bg: #020617;
  --bg-alt: #030712;
  --card: rgba(15, 23, 42, 0.96);
  --border: rgba(148, 163, 184, 0.35);
  --cyan: #22d3ee;
  --blue: #3b82f6;
  --purple: #a855f7;
  --pink: #fb7185;
  --text: #e5e7eb;
  --muted: #9ca3af;
  --radius-lg: 24px;
  --radius-md: 18px;
  --shadow-soft: 0 24px 60px rgba(15, 23, 42, 0.9);
  --layout-max: 960px;
  --scrim: rgba(2, 6, 23, 0.82);
}

[data-theme="light"] {
  --bg: #f7f8fb;
  --bg-alt: #eef2ff;
  --card: #ffffff;
  --border: rgba(99, 102, 241, 0.2);
  --cyan: #0ea5e9;
  --blue: #2563eb;
  --purple: #7c3aed;
  --pink: #ec4899;
  --text: #0f172a;
  --muted: #475569;
  --shadow-soft: 0 16px 40px rgba(99, 102, 241, 0.12);
  --scrim: rgba(15, 23, 42, 0.15);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
    "Segoe UI", sans-serif;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% -10%, rgba(56, 189, 248, 0.28), transparent 60%),
    radial-gradient(circle at 90% 110%, rgba(217, 70, 239, 0.3), transparent 60%),
    radial-gradient(circle at -10% 80%, rgba(59, 130, 246, 0.25), transparent 55%),
    #020617;
  color: var(--text);
  display: flex;
  flex-direction: column;
  transition: background 0.3s ease, color 0.3s ease;
}

[data-theme="light"] body {
  background:
    radial-gradient(circle at 10% -10%, rgba(14, 165, 233, 0.18), transparent 60%),
    radial-gradient(circle at 90% 110%, rgba(124, 58, 237, 0.18), transparent 60%),
    radial-gradient(circle at -10% 80%, rgba(236, 72, 153, 0.18), transparent 55%),
    #f7f8fb;
}

.app {
  max-width: min(var(--layout-max), 100%);
  margin: 0 auto;
  width: 100%;
  padding: 16px 16px 80px;
}

/* HEADER */

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-orb {
  width: 48px;
  height: 48px;
  border-radius: 999px;
  background:
    conic-gradient(
      from 120deg,
      rgba(34, 211, 238, 0.95),
      rgba(59, 130, 246, 0.9),
      rgba(168, 85, 247, 0.9),
      rgba(251, 113, 133, 0.85),
      rgba(34, 211, 238, 0.95)
    );
  position: relative;
  box-shadow:
    0 0 0 2px rgba(15, 23, 42, 0.9),
    0 0 24px rgba(168, 85, 247, 0.65),
    0 0 36px rgba(59, 130, 246, 0.55);
  overflow: hidden;
  position: relative;
}

.logo-orb::after {
  content: "";
  position: absolute;
  inset: 4px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #ffffff, rgba(255, 255, 255, 0));
  mix-blend-mode: screen;
  opacity: 0.9;
}

.logo-orb::before {
  content: "";
  position: absolute;
  inset: -20%;
  background: conic-gradient(
    from 0deg,
    rgba(255, 255, 255, 0.18),
    rgba(255, 255, 255, 0)
  );
  animation: spinOrbs 6s linear infinite;
}

@keyframes spinOrbs {
  to {
    transform: rotate(360deg);
  }
}

.logo-orb-svg {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.4));
}

.logo-title {
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-size: 12px;
}

.logo-sub {
  font-size: 11px;
  color: var(--muted);
}

.pill {
  font-size: 11px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.5);
  padding: 4px 12px;
  color: var(--cyan);
  background: linear-gradient(120deg, rgba(34, 211, 238, 0.18), transparent);
}

.theme-toggle {
  margin-left: 8px;
  padding: 6px 12px;
}

/* MAIN / CARDS */

main {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.card {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 14px 16px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  inset: -40%;
  background:
    radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.18), transparent 60%),
    radial-gradient(circle at 100% 100%, rgba(217, 70, 239, 0.2), transparent 60%);
  opacity: 0.6;
  pointer-events: none;
  mix-blend-mode: screen;
}

.card > * {
  position: relative;
  z-index: 1;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 13px;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 500;
  color: var(--text);
}

.card-title .icon {
  font-size: 18px;
}

.card-main-text {
  font-size: 14px;
  line-height: 1.6;
}

.card-subtext {
  margin-top: 8px;
  font-size: 11px;
  color: var(--muted);
}

/* BUTTONS */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border-radius: 999px;
  border: none;
  outline: none;
  padding: 9px 16px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  margin-top: 8px;
  transition: transform 0.12s ease, box-shadow 0.12s ease, opacity 0.12s ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--cyan), var(--blue), var(--purple));
  color: #020617;
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.9),
    0 18px 40px rgba(37, 99, 235, 0.7);
}

.btn-ghost {
  background: var(--bg);
  color: var(--muted);
  border: 1px solid var(--border);
}

.btn:hover {
  opacity: 0.95;
}

.btn:active {
  transform: translateY(1px) scale(0.99);
}

.btn-icon {
  padding: 4px 8px;
  font-size: 11px;
}

/* INPUTS */

label {
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 4px;
  display: block;
}

.prompt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.prompt-row label {
  margin-bottom: 0;
}

select,
textarea,
input[type="text"] {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  padding: 8px 10px;
  color: var(--text);
  font-size: 13px;
  margin-bottom: 8px;
  outline: none;
}

select:focus,
textarea:focus,
input[type="text"]:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.5);
}

textarea {
  min-height: 90px;
  resize: vertical;
}

/* STREAK / JOURNAL */

.home-streak-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.streak-count {
  font-size: 24px;
  font-weight: 600;
  color: var(--cyan);
}

.streak-label {
  font-size: 11px;
  color: var(--muted);
}

.week-bar {
  display: flex;
  gap: 6px;
  margin-top: 8px;
}

.week-dot {
  width: 11px;
  height: 11px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.3);
}

.week-dot.active {
  background: var(--purple);
  box-shadow: 0 0 10px rgba(168, 85, 247, 0.9);
}

.habit-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.habit-item {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px;
  background: var(--card);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.6);
}

.habit-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 14px;
  margin-bottom: 6px;
}

.habit-item-name {
  font-weight: 600;
  color: var(--text);
}

.habit-item-streak {
  font-weight: 600;
  color: var(--cyan);
}

.habit-item-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 8px;
}

.habit-freeze {
  color: var(--purple);
}

.habit-item-actions {
  display: flex;
  gap: 8px;
}

.journal-output p,
.affirmations-list p {
  font-size: 13px;
  margin-bottom: 4px;
}

.journal-output {
  min-height: 120px;
  transition: min-height 0.2s ease, box-shadow 0.2s ease;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 8px;
}

.journal-output.expanded {
  min-height: 220px;
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.4), 0 12px 30px rgba(34, 211, 238, 0.15);
}

.journal-output.reading-view {
  min-height: 260px;
  box-shadow:
    0 0 0 1px rgba(59, 130, 246, 0.35),
    0 20px 40px rgba(59, 130, 246, 0.25),
    0 0 0 8px rgba(59, 130, 246, 0.05);
  transform: translateY(-2px);
}

.reflection-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: var(--scrim);
  backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.reflection-overlay-inner {
  width: 100%;
  max-width: 520px;
  max-height: 90vh;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  padding: 14px 14px 10px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.overlay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.overlay-title {
  font-weight: 600;
  font-size: 14px;
}

.reflection-overlay-body {
  flex: 1;
  overflow-y: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px;
  background: var(--bg);
  line-height: 1.6;
  min-height: 280px;
}

.overlay-footer {
  display: flex;
  justify-content: flex-end;
}

.history-overlay {
  position: fixed;
  inset: 0;
  z-index: 998;
  background: var(--scrim);
  backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.history-overlay-inner {
  width: 100%;
  max-width: 540px;
  max-height: 90vh;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.history-overlay-body {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.history-item {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px;
  background: var(--card);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.history-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.history-item-title {
  font-weight: 600;
  font-size: 13px;
}

.history-item-meta {
  font-size: 11px;
  color: var(--muted);
}

.history-item-snippet {
  font-size: 12px;
  color: var(--text);
}

.history-item button {
  align-self: flex-start;
}

body.no-scroll {
  overflow: hidden;
}

.journal-history {
  margin-top: 8px;
  border-top: 1px solid var(--border);
  padding-top: 6px;
  max-height: 120px;
  overflow-y: auto;
}

.journal-history-item {
  font-size: 11px;
  color: var(--muted);
}

/* NAV */

nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: min(var(--layout-max), 100%);
  margin: 0 auto;
  background: var(--card);
  backdrop-filter: blur(28px);
  border-top: 1px solid var(--border);
  z-index: 1200;
  pointer-events: auto;
}

.nav-inner {
  display: flex;
  justify-content: space-around;
  padding: 8px 10px 10px;
  pointer-events: auto;
}

.nav-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 10px;
  padding: 4px 0;
  cursor: pointer;
}

.nav-btn-icon {
  font-size: 18px;
}

.nav-btn.active {
  color: var(--cyan);
}

/* UTIL */

.hidden {
  display: none;
}

@media (min-width: 768px) {
  .app {
    padding-top: 24px;
  }

  #screen-home,
  #screen-affirm,
  #screen-journal,
  #screen-habit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    align-items: start;
  }

  .card {
    height: 100%;
  }
}
