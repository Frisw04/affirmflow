function markTodayDone(id) {
  const habits = getHabits();
  const idx = habits.findIndex((h) => h.id === id);
  if (idx === -1) return;
  const habit = habits[idx];

  const now = new Date();
  const todayStr = now.toISOString().slice(0, 10);

  if (habit.lastDate === todayStr) {
    return; // already logged today
  }

  const snapshot = {
    streak: habit.streak || 0,
    lastDate: habit.lastDate || null,
    freezesLeft: habit.freezesLeft ?? 3,
  };

  let newStreak = habit.streak ? habit.streak : 0;
  if (habit.lastDate) {
    const last = new Date(habit.lastDate);
    const todayMidnight = new Date(todayStr);
    const lastMidnight = new Date(last.toISOString().slice(0, 10));
    const diffDays = Math.floor(
      (todayMidnight - lastMidnight) / 86400000
    );
    if (diffDays === 1) {
      newStreak = newStreak + 1;
    } else if (diffDays > 1) {
      if (habit.freezesLeft && habit.freezesLeft > 0) {
        habit.freezesLeft -= 1; // spend a freeze to keep streak
      } else {
        newStreak = 0;
      }
      newStreak = newStreak + 1;
    }
  } else {
    newStreak = 1;
  }

  habits[idx] = {
    ...habit,
    streak: newStreak,
    lastDate: todayStr,
    freezesLeft: habit.freezesLeft ?? 0,
    prev: snapshot,
  };

  setHabits(habits);
  renderHabitUI();
}

function deleteHabit(id) {
  const habits = getHabits().filter((h) => h.id !== id);
  setHabits(habits, id);
  renderHabitUI();
}

