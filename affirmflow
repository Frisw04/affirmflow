function getHabits() {
  // migrate old single habit if present
  const legacy = JSON.parse(
    localStorage.getItem("affirmflow_habit") || "null"
  );
  const existing = JSON.parse(
    localStorage.getItem("affirmflow_habits") || "[]"
  );
  if (legacy && !existing.length) {
    const migrated = [
      {
        id: Date.now(),
        name: legacy.name || "Glow-up habit",
        streak: legacy.streak || 0,
        lastDate: legacy.lastDate || null,
        freezesLeft: 3,
      },
    ];
    localStorage.setItem("affirmflow_habits", JSON.stringify(migrated));
    localStorage.removeItem("affirmflow_habit");
    return migrated;
  }
  return existing;
}

