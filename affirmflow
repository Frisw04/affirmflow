  const listEl = document.getElementById("habitList");

  const best = habits.reduce(
    (acc, h) => (h.streak > (acc?.streak || 0) ? h : acc),
    null
  );

  streakCountEl.textContent = best ? best.streak || 0 : 0;
  habitNameLabel.textContent = best ? best.name : "No habit set yet";

  if (!listEl) return;
  listEl.innerHTML = "";
  if (!habits.length) {
    listEl.innerHTML = `<p class="streak-label">No habits yet. Add one above.</p>`;
    return;
  }

  habits.forEach((habit) => {
    const card = document.createElement("div");
