function getJournalData() {
  if (journalCache.length) return journalCache;
  const local = JSON.parse(localStorage.getItem("affirmflow_journal") || "[]");
  journalCache = local;
  return journalCache;
}

function setJournalData(list, deletedId = null) {
  journalCache = list;
  localStorage.setItem("affirmflow_journal", JSON.stringify(list));
  if (supabaseClient && currentUser) {
    const clean = list.map((entry) => ({
      id: entry.id || (crypto.randomUUID ? crypto.randomUUID() : Date.now()),
      user_id: currentUser.id,
      title: entry.title || "Untitled",
      raw: entry.raw || "",
      ai: entry.ai || "",
      date: entry.date || new Date().toLocaleString(),
      entry_date: entry.entryDate || entry.entry_date || null,
      mood: entry.mood || "",
      focus: entry.focus || "",
    }));
    supabaseClient.from("journal_entries").upsert(clean).then(() => {
      if (deletedId) {
        supabaseClient
          .from("journal_entries")
          .delete()
          .eq("id", deletedId)
          .eq("user_id", currentUser.id);
      }
    });
  }
}

function getHabits() {
  if (habitCache.length) return habitCache;
  const local = JSON.parse(localStorage.getItem("affirmflow_habits") || "[]");
  habitCache = local;
  return habitCache;
}

function setHabits(list, deletedId = null) {
